# Required environment variables for the OpenClaw gateway
# Copy to ~/.openclaw/.env on the target instance and fill in values

# LLM Provider
ANTHROPIC_API_KEY=

# Blossom Backend
BLOSSOM_API_URL=
BLOSSOM_INTERNAL_KEY=

# HikerAPI (Instagram data)
HIKER_API_KEY=

# Web Search
BRAVE_API_KEY=

# Gateway Auth Token
OPENCLAW_GATEWAY_TOKEN=
