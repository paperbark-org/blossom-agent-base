# OpenClaw Gateway — HexClad AU
# Install: sudo cp openclaw-hexclad-au.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now openclaw-hexclad-au

[Unit]
Description=OpenClaw Gateway - HexClad AU
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hexclad_au
Group=hexclad_au
WorkingDirectory=/home/hexclad_au
EnvironmentFile=/home/hexclad_au/.openclaw/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/hexclad_au
Environment=NODE_ENV=production
ExecStart=/usr/bin/openclaw gateway --bind loopback --port 18790
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
