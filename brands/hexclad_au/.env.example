# Required environment variables for HexClad AU instance
# Copy to ~/.openclaw/.env on the target instance and fill in values

# LLM Provider
ANTHROPIC_API_KEY=

# Blossom Backend
BLOSSOM_API_URL=
BLOSSOM_INTERNAL_KEY=
BLOSSOM_USER_ID=

# Brand Identity (used by backend for DB routing)
BLOSSOM_BRAND_ID=hexclad_au
BLOSSOM_BRAND_NAME=HexClad Australia

# HikerAPI (Instagram data)
HIKER_API_KEY=

# Web Search
BRAVE_API_KEY=

# Qdrant (shared creator DB -- read-only)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=instagram_influencers

# OpenAI (for embeddings -- text-embedding-3-small)
OPENAI_API_KEY=

# Gateway Auth Token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=
